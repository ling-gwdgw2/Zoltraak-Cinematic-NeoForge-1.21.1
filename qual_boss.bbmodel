e_placeholders":"query.ground_speed = slider('ground_speed')\nvariable.bv = slider('bv')\nquery.vertical_speed = slider('vertical_speed')\nquery.yaw_speed = slider('yaw_speed')\nvariable.hairso = slider('hairso')\nvariable.realgroundspeed = slider('realgroundspeed')\nvariable.hairyawso = slider('hairyawso')\nvariable.deltahairso = slider('deltahairso')\nvariable.interpolation = slider('interpolation')\nvariable.interpolationso1 = slider('interpolationso1')\nvariable.interpolationso2 = slider('interpolationso2')\nvariable.alpha = slider('alpha')\nvariable.tail_a = slider('tail_a')\nvariable.roaming = slider('roaming')\nquery.is_item_name_any('legs', 'minecraft:netherite_leggings') = toggle('is_item_name_any:legs, minecraft:netherite_leggings')\nquery.equipped_item_any_tag('mainhand', 'minecraft:swords') = slider('equipped_item_any_tag:mainhand, minecraft:swords')\nquery.is_item_name_any('mainhand', 'minecraft:bow') = toggle('is_item_name_any:mainhand, minecraft:bow')\nvariable.model_scale = slider('model_scale')"}